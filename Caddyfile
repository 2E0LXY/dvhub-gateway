# DVHub production reverse proxy. Set DVHUB_PASSWORD_HASH to a Caddy bcrypt
# hash before starting Caddy, for example with `caddy hash-password`.

(dvhub-common) {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @protected not path /ysf-status.html /api/public/ysf_dashboard
    basic_auth @protected {
        {$DVHUB_USER:2E0LXY} {$DVHUB_PASSWORD_HASH}
    }

    reverse_proxy /ws 127.0.0.1:8080 {
        flush_interval -1
    }
    reverse_proxy /api/* 127.0.0.1:8080

    root * /var/www/dvhub
    file_server
}

ai.2e0lxy.uk, https://194.146.49.25 {
    import dvhub-common
    log {
        output file /var/log/caddy/dvhub-access.log
        format json
    }
}

# Local HTTP testing without occupying the gateway's loopback port.
http://localhost {
    import dvhub-common
}
