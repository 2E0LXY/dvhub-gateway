# DVHub production reverse proxy. Set DVHUB_PASSWORD_HASH to a Caddy bcrypt
# hash before starting Caddy, for example with `caddy hash-password`.

(dvhub-common) {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    @protected not path /ysf-status.html /api/public/ysf_dashboard /ws
    # `basicauth` is the pre-2.8 name and remains a supported alias in current
    # Caddy. Keeping it here lets the Debian-packaged Caddy validate this file.
    basicauth @protected {
        {$DVHUB_USER:2E0LXY} {$DVHUB_PASSWORD_HASH}
    }

    # Never trust an identity header supplied by the browser. Each protected
    # upstream route below replaces it with Caddy's authenticated username.
    request_header -X-DVHub-Authenticated-User

    @dashboard path / /dashboard.html
    header @dashboard Cache-Control "no-store, no-cache, must-revalidate"
    reverse_proxy @dashboard unix//run/dvhub/gateway.sock {
        # This is a single-operator appliance. Set the identity explicitly
        # after Basic Auth so older Debian Caddy releases cannot lose the
        # authenticated-user placeholder between nested routes.
        header_up X-DVHub-Authenticated-User 2E0LXY
    }

    reverse_proxy /ws unix//run/dvhub/gateway.sock {
        flush_interval -1
        header_up -X-DVHub-Authenticated-User
    }
    reverse_proxy /api/* unix//run/dvhub/gateway.sock {
        header_up X-DVHub-Authenticated-User 2E0LXY
    }
    reverse_proxy /talkgroups.js unix//run/dvhub/gateway.sock {
        header_up X-DVHub-Authenticated-User 2E0LXY
    }

    root * /var/www/dvhub
    file_server
}

ai.2e0lxy.uk, https://194.146.49.25 {
    import dvhub-common
    log {
        output file /var/log/caddy/dvhub-access.log
        format json
    }
}

# Local HTTP testing without occupying the gateway's loopback port.
http://localhost {
    import dvhub-common
}
