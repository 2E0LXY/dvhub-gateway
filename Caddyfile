# DVHub production reverse proxy. Set DVHUB_PASSWORD_HASH to a Caddy bcrypt
# hash before starting Caddy, for example with `caddy hash-password`.

(dvhub-common) {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    # Public status routes are read-only. Admin pages and all remaining API
    # endpoints retain Basic Auth, and the browser can never choose the
    # identity header presented to the gateway.
    route {
        request_header -X-DVHub-Authenticated-User

        handle /admin* {
            basicauth {
                {$DVHUB_USER:2E0LXY} {$DVHUB_PASSWORD_HASH}
            }
            reverse_proxy unix//run/dvhub/gateway.sock {
                header_up X-DVHub-Authenticated-User 2E0LXY
            }
        }

        @authenticated_ticket {
            path /api/ws_ticket
            header Authorization *
        }
        handle @authenticated_ticket {
            basicauth {
                {$DVHUB_USER:2E0LXY} {$DVHUB_PASSWORD_HASH}
            }
            reverse_proxy unix//run/dvhub/gateway.sock {
                header_up X-DVHub-Authenticated-User 2E0LXY
            }
        }

        handle /api/ws_ticket {
            reverse_proxy unix//run/dvhub/gateway.sock
        }
        handle /api/public/* {
            reverse_proxy unix//run/dvhub/gateway.sock
        }
        handle /ws {
            reverse_proxy unix//run/dvhub/gateway.sock {
                flush_interval -1
            }
        }
        handle /api/* {
            basicauth {
                {$DVHUB_USER:2E0LXY} {$DVHUB_PASSWORD_HASH}
            }
            reverse_proxy unix//run/dvhub/gateway.sock {
                header_up X-DVHub-Authenticated-User 2E0LXY
            }
        }
        handle /talkgroups.js {
            reverse_proxy unix//run/dvhub/gateway.sock
        }
        handle / {
            header Cache-Control "no-store, no-cache, must-revalidate"
            reverse_proxy unix//run/dvhub/gateway.sock
        }
        handle /dashboard.html {
            header Cache-Control "no-store, no-cache, must-revalidate"
            reverse_proxy unix//run/dvhub/gateway.sock
        }
        handle {
            root * /var/www/dvhub
            file_server
        }
    }
}

ai.2e0lxy.uk, https://194.146.49.25 {
    import dvhub-common
    log {
        output file /var/log/caddy/dvhub-access.log
        format json
    }
}

# Local HTTP testing without occupying the gateway's loopback port.
http://localhost {
    import dvhub-common
}
