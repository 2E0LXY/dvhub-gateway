# Use the stable path reported by: ls -l /dev/serial/by-id/
AMBE_DEVICE=/dev/serial/by-id/usb-DVMEGA_DVstick_30_CHANGE_ME
AMBE_BAUD=460800
AMBE_MODE=dmr

# Bind to the OpenClaw machine's Tailscale/WireGuard address, not 0.0.0.0.
AMBE_BIND=100.64.0.2:2460

# Allow only the DVHub VPS VPN address. One CIDR is accepted by the systemd unit.
AMBE_ALLOW=100.64.0.1/32
