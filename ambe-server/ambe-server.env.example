# Use the stable path reported by: ls -l /dev/serial/by-id/
AMBE_DEVICE=/dev/serial/by-id/usb-DVMEGA_DVstick_30_CHANGE_ME
AMBE_BAUD=460800
AMBE_MODE=dmr

# The router forwards public UDP 2468 to this machine. Keep the source allowlist.
AMBE_BIND=0.0.0.0:2468

# Allow only the DVHub VPS. One CIDR is accepted by the systemd unit.
AMBE_ALLOW=194.146.49.25/32
