<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/identity" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/dv_text" android:textStyle="bold" />
        <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dv_muted" />
    </LinearLayout>
    <TextView android:id="@+id/nameLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dv_muted" android:textSize="12sp" />
    <TextView android:id="@+id/route" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/dv_green" />
    <TextView android:id="@+id/metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dv_cyan" android:textSize="12sp" />
</LinearLayout>
