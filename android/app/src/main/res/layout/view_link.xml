<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK LINK CONTROL" android:textColor="@color/dv_green" android:textSize="16sp" android:textStyle="bold" />
        <Spinner android:id="@+id/networkSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_card" />
        <Spinner android:id="@+id/talkgroupSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" />
        <EditText android:id="@+id/networkPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="User / hotspot credential" android:inputType="textPassword" android:textColor="@color/dv_text" android:textColorHint="@color/dv_muted" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:text="Master-server credentials are loaded securely from DMR_Hosts.txt." android:textColor="@color/dv_muted" android:textSize="12sp" />
        <EditText android:id="@+id/dmrOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="DMR options (optional)" android:textColor="@color/dv_text" android:textColorHint="@color/dv_muted" />
        <Button android:id="@+id/linkButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Connect link" />
        <TextView android:id="@+id/linkStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Disconnected" android:textColor="@color/dv_muted" />
        <Button android:id="@+id/pttButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:enabled="false" android:text="BROWSER PTT UNAVAILABLE" android:textColor="@color/dv_muted" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="8dp" android:text="Voice uses the managed MMDVM cross-mode services. Native app TX/RX is disabled." android:textColor="@color/dv_muted" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
