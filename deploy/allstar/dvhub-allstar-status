#!/bin/sh
set -eu

if grep -q '^register => 530471:' /etc/asterisk/rpt_http_registrations.conf 2>/dev/null; then
    echo 'CONFIGURED yes'
else
    echo 'CONFIGURED no'
fi
echo REGISTRATIONS
/usr/sbin/asterisk -rx 'rpt show registrations' 2>/dev/null || true
echo LINKS
/usr/sbin/asterisk -rx 'rpt nodes 530471' 2>/dev/null || true
echo STATS
/usr/sbin/asterisk -rx 'rpt stats 530471' 2>/dev/null || true
