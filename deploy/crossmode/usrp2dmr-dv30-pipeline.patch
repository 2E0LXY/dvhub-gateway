+void MBEVocoder::decode_dmr_burst(const uint8_t *ambe1, const uint8_t *ambe2, const uint8_t *ambe3,
+	int16_t *pcm1, int16_t *pcm2, int16_t *pcm3)
+{
+	::memset(pcm1, 0, 320U);
+	::memset(pcm2, 0, 320U);
+	::memset(pcm3, 0, 320U);
+	if (m_socket < 0)
+		return;
+
+	const uint8_t* inputs[3U] = {ambe1, ambe2, ambe3};
+	int16_t* outputs[3U] = {pcm1, pcm2, pcm3};
+	uint8_t channels[3U];
+	bool complete[3U] = {false, false, false};
+	for (unsigned int i = 0U; i < 3U; i++) {
+		channels[i] = ++m_channel;
+		uint8_t request[11U];
+		request[0U] = 0x63U;
+		request[1U] = channels[i];
+		::memcpy(request + 2U, inputs[i], 9U);
+		if (::send(m_socket, request, sizeof(request), 0) != (ssize_t)sizeof(request))
+			return;
+	}
+
+	unsigned int completed = 0U;
+	uint8_t response[512U];
+	while (completed < 3U) {
+		ssize_t length = ::recv(m_socket, response, sizeof(response), 0);
+		if (length < 0)
+			return;
+		for (unsigned int i = 0U; i < 3U; i++) {
+			if (complete[i] || length < 2 || response[1U] != channels[i])
+				continue;
+			if (response[0U] == 0x7FU) {
+				complete[i] = true;
+				completed++;
+			} else if (length >= 322 && response[0U] == 0x64U) {
+				::memcpy(reinterpret_cast<uint8_t*>(outputs[i]), response + 2U, 320U);
+				complete[i] = true;
+				completed++;
+			}
+		}
+	}
+}
