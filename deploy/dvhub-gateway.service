[Unit]
Description=Yorkshire Link HUB DV Gateway
Documentation=https://github.com/2E0LXY/dvhub-gateway
Wants=network-online.target
After=network-online.target ysfreflector.service

[Service]
Type=simple
User=dvhub
Group=dvhub
WorkingDirectory=/opt/dvhub-gateway
RuntimeDirectory=dvhub
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/dvhub-gateway
Restart=on-failure
RestartSec=3s
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Prefix optional integration paths with "-" so a fresh host can start before
# every reflector/converter package has created its configuration directory.
ReadWritePaths=-/var/lib/dvgateway -/var/log/ysf2dmr -/etc/asterisk -/etc/dvhub -/etc/ysfreflector -/etc/ysf2dmr
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
