#!/usr/bin/python3
"""Replace only the protected BrandMeister conference credential.

The credential is accepted on stdin as JSON so it never appears in process
arguments, systemd logs, or shell history.
"""

import json
import os
import pwd
import sys
import tempfile


CONFIG_PATH = "/etc/dvhub/yorkshire-conference.json"
MAX_INPUT = 4096


def fail(message: str, code: int = 64) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


if os.geteuid() != 0:
    fail("dvhub-set-conference-credential must run through sudo", 77)

raw = sys.stdin.buffer.read(MAX_INPUT + 1)
if len(raw) > MAX_INPUT:
    fail("credential request is too large")

try:
    request = json.loads(raw)
    credential = request["brandmeister_password"]
except (KeyError, TypeError, ValueError, json.JSONDecodeError):
    fail("invalid credential request")

if not isinstance(credential, str) or not 1 <= len(credential) <= 128:
    fail("invalid BrandMeister credential")
if any(ord(character) < 32 or ord(character) == 127 for character in credential):
    fail("BrandMeister credential contains control characters")

try:
    with open(CONFIG_PATH, "r", encoding="utf-8") as source:
        config = json.load(source)
except (OSError, ValueError) as error:
    fail(f"unable to read conference configuration: {error}", 69)

config["brandmeister_password"] = credential
directory = os.path.dirname(CONFIG_PATH)
temporary_path = ""
try:
    descriptor, temporary_path = tempfile.mkstemp(prefix=".yorkshire-conference.", dir=directory)
    with os.fdopen(descriptor, "w", encoding="utf-8") as output:
        json.dump(config, output, indent=2)
        output.write("\n")
        output.flush()
        os.fsync(output.fileno())
    dvhub_group = pwd.getpwnam("dvhub").pw_gid
    os.chown(temporary_path, 0, dvhub_group)
    os.chmod(temporary_path, 0o640)
    os.replace(temporary_path, CONFIG_PATH)
    temporary_path = ""
    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
except OSError as error:
    fail(f"unable to update conference configuration: {error}", 74)
finally:
    if temporary_path:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass

print("BrandMeister conference credential updated")
