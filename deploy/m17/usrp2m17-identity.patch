+static bool validIdentityCallsign(const std::string& callsign)
+{
+	if (callsign.size() < 3U || callsign.size() > 9U)
+		return false;
+
+	for (std::string::const_iterator it = callsign.begin(); it != callsign.end(); ++it) {
+		if (!::isalnum(static_cast<unsigned char>(*it)) && *it != '/' && *it != '-')
+			return false;
+	}
+
+	return true;
+}
+
+static void sendIdentity(CUDPSocket* socket, const in_addr& address, unsigned int port, bool active, const std::string& callsign)
+{
+	if (socket == NULL || port == 0U)
+		return;
+
+	char message[64U];
+	::snprintf(message, sizeof(message), "DVHUBID1 M17 %u %s", active ? 1U : 0U, active ? callsign.c_str() : "-");
+	socket->write(reinterpret_cast<const unsigned char*>(message), ::strlen(message), address, port);
+}
