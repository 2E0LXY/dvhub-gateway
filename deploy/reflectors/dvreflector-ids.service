[Unit]
Description=Update Yorkshire Link HUB P25 and NXDN identity databases
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl -fsS --retry 3 --connect-timeout 15 --max-time 120 -o /var/lib/nxdnreflector/NXDN.csv.tmp https://www.radioid.net/static/nxdn.csv
ExecStart=/usr/bin/install -o nxdnreflector -g nxdnreflector -m 0644 /var/lib/nxdnreflector/NXDN.csv.tmp /var/lib/nxdnreflector/NXDN.csv
ExecStart=/usr/bin/rm -f /var/lib/nxdnreflector/NXDN.csv.tmp
ExecStart=/usr/bin/install -o p25reflector -g p25reflector -m 0644 /var/lib/dvgateway/dmrid.dat /var/lib/p25reflector/DMRIds.dat
ExecStart=/usr/bin/install -o nxdnbridge -g nxdnbridge -m 0644 /var/lib/dvgateway/dmrid.dat /var/lib/nxdn2dmr/DMRIds.dat
ExecStart=/usr/bin/install -o nxdnbridge -g nxdnbridge -m 0644 /var/lib/nxdnreflector/NXDN.csv /var/lib/nxdn2dmr/NXDN.csv
ExecStart=/usr/bin/install -o p25bridge -g p25bridge -m 0644 /var/lib/dvgateway/dmrid.dat /var/lib/p252dmr/DMRIds.dat
ExecStart=/usr/bin/install -o allstarbridge -g allstarbridge -m 0644 /var/lib/dvgateway/dmrid.dat /var/lib/usrp2dmr/DMRIds.dat
