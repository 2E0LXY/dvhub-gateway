# Copy to /etc/dvhub/xlxd.env only after choosing an unused XLX number.
# Do not publish a private test reflector through a call-home dashboard.
XLX_DISPLAY_NAME=XLXYOR
XLX_CALLSIGN=XLX000
XLX_LISTEN_IP=0.0.0.0
# DVxCode joins module A over DExtra; XLXd's legacy AMBED controller remains
# loopback-only and unused by this staged design.
XLX_TRANSCODER_IP=127.0.0.1
