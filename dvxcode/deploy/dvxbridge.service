[Unit]
Description=dvxcode D-STAR <-> DMR bridge
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/dvxbridge -config /etc/dvxbridge.ini
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
DynamicUser=yes
StateDirectory=dvxbridge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
